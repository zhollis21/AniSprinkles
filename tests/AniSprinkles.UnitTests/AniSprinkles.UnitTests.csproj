<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AniSprinkles.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- NUnit on Microsoft.Testing.Platform (#168, #175). The runner is chosen for the whole repo by
         "test.runner" in global.json; EnableNUnitRunner is what makes NUnit3TestAdapter build this
         project into an MTP executable instead of a VSTest adapter, which is why there is no
         Microsoft.NET.Test.Sdk here. Same packages and versions as KingdomWatch's Core.Tests, so
         the two repos share one framework (#175). -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NSubstitute" />
    <!-- Inert unless a run passes the hangdump option. CI does: a run that stalls past the timeout prints
         the tests still in flight, writes a dump of the test process and fails, rather than
         sitting silent until the job timeout with its output still buffered. -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>

  <ItemGroup>
    <!-- AniSprinkles.Core targets plain net11.0 precisely so this project can reference it. Before
         #62 the models, services and page models were link-compiled here file by file, which meant
         nothing that touched Shell, a popup or the icon font could be tested at all. CommunityToolkit.Mvvm,
         Microsoft.Maui.Essentials/Core and Microsoft.Extensions.Logging.Abstractions all arrive
         transitively from Core, so they are no longer listed above. -->
    <ProjectReference Include="..\..\src\AniSprinkles.Core\AniSprinkles.Core.csproj" />
  </ItemGroup>

</Project>
