<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
             x:Class="AniSprinkles.Pages.MyMangaPage"
             Title="Library"
             Shell.TitleColor="{Binding Converter={StaticResource RainbowAccentConverter}, ConverterParameter='Manga'}">

    <!-- Placeholder for the manga half of the Library tab; filled in by #12. -->
    <VerticalStackLayout Padding="{StaticResource LayoutPadding}"
                         Spacing="12"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
        <Label Text="{x:Static icons:FluentIconsRegular.BookOpen24}"
               FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
               FontSize="48"
               TextColor="{StaticResource Gray400}"
               HorizontalOptions="Center"
               AutomationProperties.IsInAccessibleTree="False" />
        <Label Text="Manga"
               Style="{StaticResource Title2}"
               TextColor="{StaticResource OnBackground}"
               HorizontalOptions="Center" />
        <Label Text="Your manga list is coming soon."
               Style="{StaticResource Caption1}"
               TextColor="{StaticResource Gray400}"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
