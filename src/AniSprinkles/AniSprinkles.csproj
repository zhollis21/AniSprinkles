<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>AniSprinkles</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<!-- XC0023: All x:DataType="{x:Null}" usages are intentional. Two patterns require this:
		     (1) DataTemplate items that bind Command to a parent view model via x:Reference while
		         CommandParameter binds to the data item (mixed binding-context in compiled-binding XAML).
		     (2) ContentView/Popup roots where the binding context is set at runtime and cannot be
		         declared statically (e.g. AuthActionsView, RatingPopup). -->
		<NoWarn>$(NoWarn);XC0023</NoWarn>
		<!-- Experiment for #172, not for merging: Material 3 control styling on Android, compared by
		     the CI screenshot diff against main. -->
		<UseMaterial3>true</UseMaterial3>

		<!-- Display name -->
		<ApplicationTitle>AniSprinkles</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.RainbowSprinkles.AniSprinkles</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#17171a" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Models, services, converters and page models live in the Core library so the unit tests
		     can reference them from plain net11.0. This project keeps everything that needs MAUI UI,
		     Android, or the icon font: pages, views, behaviors, and the adapters in Services/Maui
		     that implement Core's abstractions. See issue #62. -->
		<ProjectReference Include="..\AniSprinkles.Core\AniSprinkles.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IconFont.Maui.FluentIcons" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="CommunityToolkit.Maui" />
		<PackageReference Include="Sentry.Maui" />
		<PackageReference Include="Syncfusion.Maui.Toolkit" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" />
		<PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
		<!-- The AndroidX companions below move as a train; versions and the reason are in
		     Directory.Packages.props. -->
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
		<PackageReference Include="Xamarin.AndroidX.Core" />
		<PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Java8" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" />
		<PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" />
	</ItemGroup>

	<!-- MAUI DevFlow agent (#170): Debug only, CI builds included. This condition is what keeps it
	     out of Release — MauiProgram's #if DEBUG only stops it being started, and the assembly not
	     being in the APK at all is the guarantee. A Release APK has no "Microsoft.Maui.DevFlow"
	     string in any entry (checked against CommunityToolkit.Maui / Sentry.Maui, which do show). -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
	</ItemGroup>

	<!-- Append CI preprocessor symbol when building for CI screenshots (-p:CiBuild=true) -->
	<!-- Restricted to Debug to prevent accidentally shipping stub services in a Release build -->
	<PropertyGroup Condition="'$(CiBuild)' == 'true' AND '$(Configuration)' == 'Debug'">
		<DefineConstants>$(DefineConstants);CI</DefineConstants>
	</PropertyGroup>

	<!-- Recorded AniList responses (#134), embedded ONLY in a CI build.
	     EmbeddedResource rather than MauiAsset because the replay handler has to enumerate what it
	     has: MAUI can open a packaged file by name but cannot list the package, whereas
	     Assembly.GetManifestResourceNames() gives the whole set without a generated index to keep in
	     sync. The condition is what keeps ~7 MB of JSON out of every Debug and Release APK. -->
	<ItemGroup Condition="'$(CiBuild)' == 'true' AND '$(Configuration)' == 'Debug'">
		<EmbeddedResource Include="Fixtures\AniList\*.json" LogicalName="AniListFixtures.%(Filename)%(Extension)" />
	</ItemGroup>
	<Target Name="_BlockCiBuildInRelease" BeforeTargets="Build" Condition="'$(CiBuild)' == 'true' AND '$(Configuration)' != 'Debug'">
		<Error Text="CiBuild=true is only supported with Debug configuration. Do not use it for Release builds." />
	</Target>

	<!-- There is no ErrorSim flag any more (#125). Fault injection is a decorator that ships
	     disarmed in every Debug build, gated on plain #if DEBUG, so simulating a failure no longer
	     needs its own build configuration — and no longer needs a Release guard, because the code
	     cannot be compiled into one. Arm it at runtime; see /run-app. -->

	<ItemGroup>
	  <MauiXaml Update="Views\ErrorStateView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<!-- .NET 11 runs Android on CoreCLR only (#168). The Mono-era switches are gone on purpose:
	     UseInterpreter is ignored (Android has no interpreter; Debug is JIT), and RunAOTCompilation
	     stops the build with XA1044 whichever way it is set. Release code generation is now the
	     SDK default, composite partial ReadyToRun, which needs PublishTrimmed to stay true. -->

	<!-- Debug Android Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidLinkMode>None</AndroidLinkMode>
		<EmbedAssembliesIntoApk>False</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<!-- Release Android Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PublishTrimmed>true</PublishTrimmed>
		<EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<!-- Native debug symbols: bundled into the AAB for Google Play Console, and uploaded to
		     Sentry by the gated PropertyGroup below when SENTRY_AUTH_TOKEN is present. -->
		<AndroidGenerateNativeDebugSymbols>true</AndroidGenerateNativeDebugSymbols>
	</PropertyGroup>

	<!-- Upload native debug symbols + ProGuard mapping to Sentry on release builds. Gated on BOTH a
	     token AND an explicit org (CI provides SENTRY_AUTH_TOKEN + SENTRY_ORG). sentry-cli needs the
	     org to be set explicitly — a token alone isn't reliable for org selection — so we require it
	     rather than risk the upload failing mid-release. With either unset the upload is simply off,
	     so local/tokenless Release builds are unaffected. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(SENTRY_AUTH_TOKEN)' != '' AND '$(SENTRY_ORG)' != ''">
		<SentryUploadSymbols>true</SentryUploadSymbols>
		<SentryUploadAndroidProGuardMapping>true</SentryUploadAndroidProGuardMapping>
		<SentryOrg>$(SENTRY_ORG)</SentryOrg>
		<SentryProject>anisprinkles</SentryProject>
	</PropertyGroup>
</Project>
