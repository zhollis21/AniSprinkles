<Project>

  <!-- Central Package Management (#168). Every package version in the repo lives here; the project
       files say which packages they use and nothing about versions. Before this, Core and the app
       each carried their own Microsoft.Maui.Controls, CommunityToolkit.Mvvm and Sentry versions and
       a comment asking that they be kept in lockstep. Now there is one number to change. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="App and Core">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageVersion Include="IconFont.Maui.FluentIcons" Version="1.1.1" />
    <PackageVersion Include="Syncfusion.Maui.Toolkit" Version="1.0.11" />
    <!-- Sentry and Sentry.Maui are one release train: the app references Sentry.Maui, Core references
         the plain Sentry package it is built on. Move them together. -->
    <PackageVersion Include="Sentry" Version="6.12.1" />
    <PackageVersion Include="Sentry.Maui" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup Label="Debug-only tooling">
    <!-- MAUI DevFlow (#170): the in-app agent the `maui devflow` CLI and MCP server drive. Preview
         only — dotnet/maui-labs has no stable release. Keep it in step with the global `maui` CLI
         (`dotnet tool list -g`); the agent and CLI ship from one repo on one version. -->
    <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.14.26555.2" />
  </ItemGroup>

  <ItemGroup Label="AndroidX">
    <PackageVersion Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageVersion Include="Xamarin.AndroidX.Work.Runtime" Version="2.12.0" />
    <!-- AndroidX companion packages are pinned as a train so NuGet does not mix old KTX bindings
         with newer base AndroidX packages pulled by MAUI/WorkManager. Revisit with each MAUI upgrade. -->
    <PackageVersion Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.19.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <!-- Matches the Microsoft.Testing.Platform version NUnit3TestAdapter brings in. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.4.1" />
  </ItemGroup>

</Project>
