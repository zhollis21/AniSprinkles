<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AniSprinkles.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Runs on Microsoft.Testing.Platform, not VSTest (#168). The runner is chosen for the whole
         repo by "test.runner" in global.json; this property is what makes the xunit v3 executable
         speak MTP natively, and xunit.v3.mtp-v2 is the package flavour built for MTP v2. That is
         why there is no Microsoft.NET.Test.Sdk or xunit.runner.visualstudio here any more. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!-- AniSprinkles.Core targets plain net11.0 precisely so this project can reference it. Before
         #62 the models, services and page models were link-compiled here file by file, which meant
         nothing that touched Shell, a popup or the icon font could be tested at all. CommunityToolkit.Mvvm,
         Microsoft.Maui.Essentials/Core and Microsoft.Extensions.Logging.Abstractions all arrive
         transitively from Core, so they are no longer listed above. -->
    <ProjectReference Include="..\..\src\AniSprinkles.Core\AniSprinkles.Core.csproj" />
  </ItemGroup>

</Project>
