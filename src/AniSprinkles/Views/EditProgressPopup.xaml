<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
               x:Class="AniSprinkles.Views.EditProgressPopup"
               x:TypeArguments="x:Object"
               x:DataType="{x:Null}"
               BackgroundColor="Transparent">

    <Border StrokeShape="RoundRectangle 20"
            StrokeThickness="0"
            Padding="24,20,24,20"
            WidthRequest="320"
            Background="{StaticResource SecondaryBackground}">
        <VerticalStackLayout Spacing="16">

            <!-- Anime title -->
            <Label x:Name="TitleLabel"
                   Text="Edit progress"
                   Style="{StaticResource Title3}"
                   HorizontalTextAlignment="Center"
                   MaxLines="2"
                   LineBreakMode="TailTruncation" />

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Opacity="0.3" />

            <!-- Header (episodes icon + label) -->
            <HorizontalStackLayout Spacing="6">
                <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Edit24}"
                                         FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                         Color="{StaticResource RainbowCyan}"
                                         Size="16" />
                    </Image.Source>
                </Image>
                <Label Text="Episodes watched" Style="{StaticResource Caption1Strong}"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{StaticResource RainbowCyan}" />
            </HorizontalStackLayout>

            <!-- Stepper: [-]  [numeric entry]  [+] -->
            <Grid ColumnDefinitions="48,*,48" ColumnSpacing="8" VerticalOptions="Center">
                <Button Grid.Column="0" x:Name="DecrementButton"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource RainbowCyan}"
                        BorderColor="{StaticResource RainbowCyan}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        Clicked="OnDecrementClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Subtract24}"
                                         FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                         Color="{StaticResource RainbowCyan}" Size="22" />
                    </Button.ImageSource>
                </Button>

                <Entry Grid.Column="1" x:Name="ProgressEntry"
                       Keyboard="Numeric"
                       HorizontalTextAlignment="Center"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource RainbowCyan}"
                       TextChanged="OnProgressTextChanged" />

                <Button Grid.Column="2" x:Name="IncrementButton"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource RainbowCyan}"
                        BorderColor="{StaticResource RainbowCyan}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        Clicked="OnIncrementClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Add24}"
                                         FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                         Color="{StaticResource RainbowCyan}" Size="22" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <!-- "of N episodes" caption (only when total is known) -->
            <Label x:Name="MaxCaption"
                   Style="{StaticResource Caption1}"
                   TextColor="{StaticResource Gray400}"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />

            <!-- Slider (only when total is known) -->
            <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" Value="0"
                    IsVisible="False"
                    ValueChanged="OnSliderValueChanged"
                    MinimumTrackColor="{StaticResource RainbowCyan}"
                    ThumbColor="{StaticResource RainbowCyan}" />

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,10,*">
                <Button Grid.Column="0" Text="Cancel"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource RainbowRed}"
                        BorderColor="{StaticResource RainbowRed}"
                        Opacity="0.85"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="24"
                        FontSize="16"
                        FontAttributes="Bold"
                        Padding="0"
                        Margin="10,12,10,10"
                        ContentLayout="Left,4"
                        Clicked="OnCancelClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Dismiss24}"
                                         FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                         Color="{StaticResource RainbowRed}" Size="18" />
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="2" Text="Save"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource RainbowGreen}"
                        BorderColor="{StaticResource RainbowGreen}"
                        CornerRadius="8"
                        HeightRequest="24"
                        FontSize="16"
                        FontAttributes="Bold"
                        Padding="0"
                        Margin="10,12,10,10"
                        ContentLayout="Left,4"
                        Clicked="OnSaveClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Checkmark24}"
                                         FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                         Color="{StaticResource RainbowGreen}" Size="18" />
                    </Button.ImageSource>
                </Button>
            </Grid>

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
