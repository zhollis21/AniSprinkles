<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
             xmlns:views="clr-namespace:AniSprinkles.Views"
             x:Class="AniSprinkles.Views.MetricBadgeView"
             x:DataType="views:MetricBadgeView"
             x:Name="Self">

    <!-- One consistent metric row (icon + value) shared by every carousel card. Callers set Glyph/IconColor
         from an ItemMetricBadge (or directly), and control visibility on this view. -->
    <HorizontalStackLayout Spacing="2">
        <Image WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
            <Image.Source>
                <FontImageSource Glyph="{Binding Glyph, Source={x:Reference Self}}"
                                 FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                 Color="{Binding IconColor, Source={x:Reference Self}}"
                                 Size="12" />
            </Image.Source>
        </Image>
        <Label Text="{Binding Text, Source={x:Reference Self}}"
               Style="{StaticResource Caption2}"
               FontAttributes="Bold"
               TextColor="{StaticResource Gray100}"
               VerticalTextAlignment="Center" />
    </HorizontalStackLayout>
</ContentView>
