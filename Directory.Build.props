<Project>

  <!-- Settings every project in the repo shares (#168). MSBuild imports this file into each project
       before the project's own properties, so a project can still override anything here. It also
       reaches the file-based tools under tools/, which build as projects of their own. Package
       versions are the other shared file: Directory.Packages.props. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Runtime async (#178): the runtime runs async methods itself instead of the compiler
         emitting a state machine class for each. It is out of preview in .NET 11 but still opt-in
         in SDK 11.0.100. Changing it does not trigger a recompile, so wipe bin/obj before
         measuring its effect. -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

</Project>
