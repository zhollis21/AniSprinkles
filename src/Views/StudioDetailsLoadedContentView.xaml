<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:AniSprinkles.PageModels"
             xmlns:models="clr-namespace:AniSprinkles.Models"
             xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
             xmlns:views="clr-namespace:AniSprinkles.Views"
             xmlns:behaviors="clr-namespace:AniSprinkles.Behaviors"
             x:Class="AniSprinkles.Views.StudioDetailsLoadedContentView"
             x:DataType="pageModels:StudioDetailsPageModel"
             x:Name="RootView">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="16">

            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Grid.Column="0"
                            WidthRequest="56"
                            HeightRequest="56"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            Padding="0"
                            VerticalOptions="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource SecondaryBackground}" />
                        </Border.Background>
                        <Image WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.MoviesAndTv24}"
                                                 FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                                 Color="{Binding PageTitle, Converter={StaticResource RainbowAccentConverter}}"
                                                 Size="28" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding Studio.DisplayName}"
                               Style="{StaticResource Title2}"
                               TextColor="{Binding PageTitle, Converter={StaticResource RainbowAccentConverter}}"
                               LineBreakMode="WordWrap" />

                        <HorizontalStackLayout Spacing="4" IsVisible="{Binding Studio.HasFavourites}">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFavouriteCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{Binding IsFavourite, Converter={StaticResource FavouriteHeartGlyphConverter}}"
                                                     FontFamily="{Binding IsFavourite, Converter={StaticResource FavouriteHeartFontConverter}}"
                                                     Color="{StaticResource RainbowPink}"
                                                     Size="14" />
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding Studio.FavouritesDisplay}"
                                   Style="{StaticResource Caption1Strong}"
                                   TextColor="{StaticResource Gray100}"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowProductionsSection}">
                <Border Style="{StaticResource SectionHeaderStyle}"
                        Background="{Binding Converter={StaticResource RainbowAccentConverter}, ConverterParameter='StudioHeader'}">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Image WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.MoviesAndTv24}"
                                                     FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                                     Color="White"
                                                     Size="20" />
                                </Image.Source>
                            </Image>
                            <Label Text="Productions" Style="{StaticResource Title3}" TextColor="White" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <views:SortDropdown Grid.Column="1"
                                            Options="{Binding ProductionsSortOptions}"
                                            SelectedCode="{Binding ProductionsSort}"
                                            SelectSortCommand="{Binding SelectProductionsSortCommand}"
                                            IsVisible="{Binding HasProductions}" />
                    </Grid>
                </Border>

                <!-- Empty state — a studio with no listed productions (rare; defensive parity with the other detail lists). -->
                <Label Text="{Binding ProductionsEmptyMessage}"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource Gray400}"
                       IsVisible="{Binding ShowProductionsEmptyState}" />

                <Grid>
                    <CollectionView ItemsSource="{Binding DisplayedProductions}"
                                    HeightRequest="248"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    RemainingItemsThreshold="3"
                                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreProductionsCommand}"
                                    InputTransparent="{Binding ProductionsBusy}"
                                    IsVisible="{Binding HasProductions}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <behaviors:ScrollToStartBehavior Trigger="{Binding ProductionsSort}" />
                        </CollectionView.Behaviors>
                        <CollectionView.Triggers>
                            <DataTrigger TargetType="CollectionView" Binding="{Binding ProductionsBusy}" Value="True">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </CollectionView.Triggers>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:StudioMediaEdge">
                                <Border Style="{StaticResource CardStyle}" Padding="0" WidthRequest="130">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer x:DataType="{x:Null}"
                                                              Command="{Binding Source={x:Reference RootView}, Path=BindingContext.NavigateToMediaCommand}"
                                                              CommandParameter="{Binding Node}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <views:CoverImage Source="{Binding Node.CoverImage.Large}"
                                                          Format="{Binding Node.Format}"
                                                          ListStatusColor="{Binding Node.ListStatusColor}"
                                                          ListStatusText="{Binding Node.ListStatusDisplay}"
                                                          PlaceholderGlyph="{x:Static icons:FluentIconsRegular.MoviesAndTv24}" />
                                        <VerticalStackLayout Padding="8,6,8,8" Spacing="2">
                                            <Label Text="{Binding Node.DisplayTitle}"
                                                   Style="{StaticResource Caption1Strong}"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation" />
                                            <views:MetricBadgeView Glyph="{Binding MetricBadge.Glyph}"
                                                                   IconColor="{Binding MetricBadge.IconColor}"
                                                                   Text="{Binding MetricBadge.Text}"
                                                                   IsVisible="{Binding HasMetricBadge}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <ActivityIndicator IsRunning="{Binding ProductionsBusy}"
                                       IsVisible="{Binding ProductionsBusy}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Color="{StaticResource RainbowCyan}"
                                       HeightRequest="36"
                                       WidthRequest="36" />
                </Grid>
            </VerticalStackLayout>

            <Border Style="{StaticResource CardStyle}" Padding="14,10"
                    IsVisible="{Binding HasSiteUrl}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenSiteUrlCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <Image WidthRequest="18" HeightRequest="18" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Globe24}"
                                             FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                             Color="{StaticResource Gray300}"
                                             Size="18" />
                        </Image.Source>
                    </Image>
                    <Label Text="View on AniList"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource Gray100}"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <ContentView HeightRequest="24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
