<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AniSprinkles.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:AniSprinkles.Pages"
    xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
    Title="AniSprinkles"
    FlyoutBehavior="Disabled"
    NavBarHasShadow="False">

    <!--
        Bottom tab bar (issue #43), replacing the hamburger flyout. Tab titles drive the tab
        label; each page keeps its own Title for the nav bar. Routes are unchanged from the
        old FlyoutItems so existing GoToAsync calls and AGENTS.md stay accurate. The Library tab is
        the one exception: #12 renamed its route from `my-anime` to `library` once both halves
        became real lists. Safe because nothing navigates to a tab root — there is not one absolute
        `GoToAsync("//…")` in the app, and the airing deep link targets `media-details`.
        TabBar colors come from the Shell style in Styles.xaml.
    -->
    <TabBar>
        <Tab x:Name="LibraryTab" Title="Library" Route="library">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Library24}"
                                 FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}" />
            </Tab.Icon>
            <!--
                Two ShellContents under one Tab render as a swipeable top tab strip on
                Android — Shell's native sub-tab support, no custom control. Both halves are
                real lists since #12.
            -->
            <ShellContent Title="Anime" Route="anime" ContentTemplate="{DataTemplate pages:AnimeLibraryPage}" />
            <ShellContent Title="Manga" Route="manga" ContentTemplate="{DataTemplate pages:MangaLibraryPage}" />
        </Tab>

        <Tab x:Name="DiscoverTab" Title="Discover" Route="discover">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Rocket24}"
                                 FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:DiscoverPage}" />
        </Tab>

        <Tab x:Name="SearchTab" Title="Search" Route="search">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Search24}"
                                 FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:SearchPage}" />
        </Tab>

        <Tab x:Name="FeedTab" Title="Feed" Route="feed">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Feed24}"
                                 FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:FeedPage}" />
        </Tab>

        <Tab x:Name="SettingsTab" Title="Settings" Route="settings">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Settings24}"
                                 FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" />
        </Tab>
    </TabBar>
</Shell>
