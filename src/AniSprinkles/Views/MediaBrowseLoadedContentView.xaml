<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:AniSprinkles.PageModels;assembly=AniSprinkles.Core"
             xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
             x:Class="AniSprinkles.Views.MediaBrowseLoadedContentView"
             x:DataType="pageModels:MediaBrowsePageModel">

    <Grid>
        <CollectionView x:Name="BrowseList"
                        ItemsSource="{Binding Items}"
                        ItemTemplate="{StaticResource BrowseMediaRowTemplate}"
                        ItemSizingStrategy="MeasureFirstItem"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.Footer>
                <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                   IsVisible="{Binding IsLoadingMore}"
                                   Margin="0,8,0,16" />
            </CollectionView.Footer>
        </CollectionView>

        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8"
                             IsVisible="{Binding ShowEmptyState}">
            <Image WidthRequest="40" HeightRequest="40" HorizontalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.MoviesAndTv24}"
                                     FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                     Color="{StaticResource Gray400}"
                                     Size="40" />
                </Image.Source>
            </Image>
            <Label Text="Nothing here yet"
                   Style="{StaticResource Body2Strong}"
                   TextColor="{StaticResource Gray400}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
