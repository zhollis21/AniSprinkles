<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:AniSprinkles.PageModels;assembly=AniSprinkles.Core"
             xmlns:views="clr-namespace:AniSprinkles.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
             x:Class="AniSprinkles.Pages.MediaBrowsePage"
             x:DataType="pageModels:MediaBrowsePageModel"
             Title="{Binding PageTitle}"
             Shell.TitleColor="{Binding PageTitle, Converter={StaticResource RainbowAccentConverter}}">

    <!-- Same view-mode switcher as AnimeLibraryPage; the mode is a shared preference between the two. -->
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ViewModeToolbarItem"
                     Command="{Binding CycleViewModeCommand}"
                     Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource x:Name="ViewModeIcon"
                                 Glyph="{x:Static icons:FluentIconsRegular.List24}"
                                 FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                 Color="{StaticResource OnBackground}"
                                 Size="20" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <views:OutageBanner Grid.Row="0" Margin="24,12,24,0" />
        <Grid Grid.Row="1"
              Padding="24,12"
              toolkit:StateContainer.CurrentState="{Binding CurrentStateKey}">
            <toolkit:StateContainer.StateViews>
                <VerticalStackLayout toolkit:StateView.StateKey="InitialLoading"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True" IsVisible="True" />
                    <Label Text="Loading list..."
                           FontSize="12"
                           TextColor="{StaticResource Gray400}" />
                </VerticalStackLayout>

                <ScrollView toolkit:StateView.StateKey="Error"
                            VerticalOptions="Center">
                    <views:ErrorStateView ErrorTitle="{Binding ErrorTitle}"
                                          ErrorSubtitle="{Binding ErrorSubtitle}"
                                          ErrorIconGlyph="{Binding ErrorIconGlyph}"
                                          ErrorAccentColor="{StaticResource RainbowOrange}"
                                          RetryCommand="{Binding RetryLoadCommand}"
                                          ShowRetryButton="{Binding CanRetry}"
                                          ErrorDetails="{Binding ErrorDetails}" />
                </ScrollView>
            </toolkit:StateContainer.StateViews>

            <ContentView x:Name="LoadedContentHost" />
        </Grid>
    </Grid>
</ContentPage>
