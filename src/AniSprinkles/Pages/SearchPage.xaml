<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:AniSprinkles.PageModels;assembly=AniSprinkles.Core"
             xmlns:views="clr-namespace:AniSprinkles.Views"
             xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
             x:Class="AniSprinkles.Pages.SearchPage"
             x:DataType="pageModels:SearchPageModel"
             Title="Search"
             Shell.TitleColor="{Binding Converter={StaticResource RainbowAccentConverter}, ConverterParameter='Search'}">

    <!--
        No StateContainer / deferred content host here, unlike Discover and My Anime: this page is
        an Entry plus one CollectionView, so there is no heavy InitializeComponent to keep off the
        UI thread during the tab transition. The four states (idle / searching / results / no
        matches) are plain visibility swaps.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="{StaticResource LayoutPadding}">
        <views:OutageBanner Grid.Row="0" />

        <!-- Row 1: always-visible search bar. On a dedicated tab there is nothing to toggle. -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="4,0"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="{x:Static icons:FluentIconsRegular.Search24}"
                       FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                       TextColor="{StaticResource Gray400}"
                       FontSize="18"
                       WidthRequest="18" HeightRequest="18"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                       VerticalOptions="Center" Margin="8,0,0,0"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Placeholder="{Binding SearchPlaceholder}"
                       Text="{Binding SearchText}"
                       ClearButtonVisibility="WhileEditing"
                       FontSize="15"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!--
            Row 2: media-type toggle (#12). AniList's search takes one type at a time, so this is a
            filter rather than a facet — flipping it re-runs whatever is typed.

            Same shape as the Settings display chips: ChipBorderStyle for the pill, the stroke and
            opacity converters keyed on SearchKindKey to mark the selection, and the label's own
            rainbow accent so Manga picks up the colour its Library sub-tab already uses. The
            explicit Style is load-bearing — the implicit Border style would otherwise fill each
            pill with the card background.
        -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Margin="0,0,0,8">
            <Border Style="{StaticResource ChipBorderStyle}" Padding="14,6"
                    Stroke="{Binding SearchKindKey, Converter={StaticResource SortFieldStrokeConverter}, ConverterParameter=Anime}"
                    Opacity="{Binding SearchKindKey, Converter={StaticResource SortFieldOpacityConverter}, ConverterParameter=Anime}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectSearchKindCommand}" CommandParameter="Anime" />
                </Border.GestureRecognizers>
                <Label Text="Anime" Style="{StaticResource ChipLabelStyle}"
                       TextColor="{Binding Converter={StaticResource RainbowAccentConverter}, ConverterParameter='Anime'}" />
            </Border>
            <Border Style="{StaticResource ChipBorderStyle}" Padding="14,6"
                    Stroke="{Binding SearchKindKey, Converter={StaticResource SortFieldStrokeConverter}, ConverterParameter=Manga}"
                    Opacity="{Binding SearchKindKey, Converter={StaticResource SortFieldOpacityConverter}, ConverterParameter=Manga}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectSearchKindCommand}" CommandParameter="Manga" />
                </Border.GestureRecognizers>
                <Label Text="Manga" Style="{StaticResource ChipLabelStyle}"
                       TextColor="{Binding Converter={StaticResource RainbowAccentConverter}, ConverterParameter='Manga'}" />
            </Border>
        </HorizontalStackLayout>

        <Grid Grid.Row="3">
            <!-- Results. Outside any ScrollView so virtualization and the scroll threshold work. -->
            <CollectionView x:Name="SearchResultsList"
                            IsVisible="{Binding IsSearchActive}"
                            ItemsSource="{Binding SearchSection.Items}"
                            ItemTemplate="{StaticResource BrowseMediaRowTemplate}"
                            ItemSizingStrategy="MeasureFirstItem"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreSearchResultsCommand}">
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding SearchIsLoadingMore}"
                                       IsVisible="{Binding SearchIsLoadingMore}"
                                       Margin="0,8,0,16" />
                </CollectionView.Footer>
            </CollectionView>

            <!-- Initial-search spinner (results list is empty while the first page loads) -->
            <ActivityIndicator IsRunning="{Binding IsSearching}"
                               IsVisible="{Binding IsSearching}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <!-- No matches -->
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 IsVisible="{Binding HasNoSearchResults}">
                <Image WidthRequest="40" HeightRequest="40" HorizontalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Search24}"
                                         FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                         Color="{StaticResource Gray400}"
                                         Size="40" />
                    </Image.Source>
                </Image>
                <Label Text="{Binding NoResultsMessage}"
                       Style="{StaticResource Body2Strong}"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!--
                Idle prompt. Discover fell back to its section rows when the query was empty;
                a dedicated tab has nothing behind the search, so it needs its own resting state.
            -->
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 IsVisible="{Binding IsIdle}">
                <Image WidthRequest="40" HeightRequest="40" HorizontalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static icons:FluentIconsRegular.Search24}"
                                         FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                         Color="{StaticResource Gray400}"
                                         Size="40" />
                    </Image.Source>
                </Image>
                <Label Text="{Binding IdlePrompt}"
                       Style="{StaticResource Body2Strong}"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Type at least two characters to start."
                       Style="{StaticResource Caption1}"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
